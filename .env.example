# ─────────────────────────────────────────────────────────────────────────────
# RUNNER 360 · Variables de entorno de la web (apps/web/.env.local)
# Copiá este archivo a apps/web/.env.local y completá los valores. NUNCA commitear secretos.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (públicas: se exponen al navegador)
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). También se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (enlaces de confirmación y recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Casilla de contacto visible en el footer (opcional; si falta se indica "pendiente")
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase · SOLO SERVIDOR. Clave secreta / service_role (webhooks de pagos y eliminación de cuentas).
# También se acepta SUPABASE_SERVICE_ROLE_KEY. Jamás usar el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Mercado Pago (suscripciones en ARS) · SOLO SERVIDOR
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe (suscripciones internacionales en USD) · SOLO SERVIDOR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
