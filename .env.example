# RUNNER 360 — variables de entorno de la app web (apps/web).
# Copiá este archivo a apps/web/.env.local y completá los valores. NUNCA subas .env.local al repositorio.

# --- Sitio ---
# Dominio público. En Vercel: https://runner360.vercel.app (los correos nunca usan localhost en producción).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Supabase (públicas: pueden llegar al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (antes "anon key"). También se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SECRETA: solo servidor) ---
# Necesaria para crear las cuentas (registro en un paso), la eliminación automática de cuentas y
# los webhooks de pago. Omite RLS: nunca la expongas al navegador ni a la app móvil.
SUPABASE_SERVICE_ROLE_KEY=

# --- Captcha invisible del registro (Cloudflare Turnstile). Ver docs/DEPLOYMENT.md ---
# Sin las dos, el registro funciona sin captcha. La clave pública va al navegador; la secreta, solo servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mercado Pago Suscripciones (SECRETAS: solo servidor). Ver docs/payments.md ---
# Con MP_ENV definido, la app valida al arrancar y no inicia si falta algo o si las credenciales no
# coinciden con el entorno (por ejemplo, MP_ENV=prod con un token TEST-).
# MP_ENV: test | prod
MP_ENV=
MP_ACCESS_TOKEN=
# "Clave secreta" de Tus integraciones → Webhooks.
MP_WEBHOOK_SECRET=
# Dominio público al que vuelve Mercado Pago (sin barra final). Si falta, se usa NEXT_PUBLIC_SITE_URL.
APP_BASE_URL=
# (Se aceptan también los nombres anteriores MERCADOPAGO_ACCESS_TOKEN y MERCADOPAGO_WEBHOOK_SECRET.)

# --- Cotización del dólar (precio de lista en USD; Mercado Pago cobra el equivalente en pesos) ---
# FX_SOURCE: dolarapi (por defecto: dólar del Banco Nación, valor de venta) | bcra (mayorista, Com. A 3500)
FX_SOURCE=dolarapi
# FX_RATE_TYPE (solo dolarapi): oficial (por defecto) | mayorista | bolsa | contadoconliqui | tarjeta | blue
FX_RATE_TYPE=oficial

# --- Tareas programadas (Vercel Cron) ---
# Vercel lo manda como "Authorization: Bearer ..." a /api/cron/diario. Generalo con: openssl rand -hex 32
CRON_SECRET=

# --- Notificaciones de pagos (ver docs/payments.md → Notificaciones) ---
# Push (Web Push): generá el par con `npx web-push generate-vapid-keys`. La pública va al navegador.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mails al admin con Resend (cuenta gratis). Sin dominio propio, solo llegan al dueño de la cuenta.
RESEND_API_KEY=
# Opcionales: destinatario (por defecto, el correo del dueño) y remitente (por defecto, onboarding@resend.dev).
ADMIN_NOTIFICATIONS_EMAIL=
RESEND_FROM=

# --- Stripe, proveedor internacional (SECRETAS, opcionales) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Solo pruebas E2E contra un backend LOCAL (se ignora con un Supabase remoto) ---
# DISABLE_RATE_LIMIT=1
