{
  "name": "@runner360/plan-library",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca de planes de running: esquema estricto del contenido, invariantes, importador y lógica pura (fechas, días exigentes, Riegel, reglas de carga).",
  "type": "module",
  "main": "./src/index.ts",
